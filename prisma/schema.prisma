generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String?           @unique
  emailVerified DateTime?
  image         String?
  /// 邮箱注册用户的 scrypt 密码散列；OAuth 用户为空
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  documents     Document[]
  settings      UserSettings?
  activities    WritingActivity[]
  assets        Asset[]
  aiProviders   AiProvider[]
  oauthAuthCodes     OAuthAuthCode[]
  oauthRefreshTokens OAuthRefreshToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Document {
  id        String            @id @default(cuid())
  title     String            @default("未命名文章")
  content   String            @default("") @db.Text
  category  String            @default("未分类")
  /// 软删除时间；非空表示在回收站
  deletedAt DateTime?
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions  DocumentVersion[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, category])
}

// 版本快照：自动保存按时间间隔留存，支持一键回滚
model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title      String
  content    String   @db.Text
  /// auto = 自动留存, manual = 手动存档, restore = 回滚前的自动备份
  kind       String   @default("auto")
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt(sort: Desc)])
}

model UserSettings {
  userId       String  @id
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  themeId      String  @default("classic")
  codeThemeId  String  @default("github")
  customCss    String  @default("") @db.Text
  macCode      Boolean @default(true)
  linkFootnote Boolean @default(true)
  /// 用户自建分类（JSON 数组），与文章上的分类取并集展示，保证空分类不消失
  categories   String  @default("[]")
  /// 可视化主题编辑器保存的「我的主题」（CustomThemeSpec JSON 数组）
  customThemes String  @default("[]") @db.Text
  /// 默认文本平台 id（对应 scope=chat 的 AiProvider.provider）；为空表示回落到首个已填密钥的平台
  aiChatProvider  String @default("")
}

/// 用户配置的 AI 文本平台凭据（内容审查用）。apiKeyEnc 为 AES-256-GCM 加密后的密钥，明文绝不落库。
model AiProvider {
  userId    String
  /// 用途：现仅剩 chat（文本对话）
  scope     String   @default("chat")
  /// 平台 id：replicate | moonshot | zhipu | deepseek
  provider  String
  /// 加密后的 API Key（空串表示尚未填写）
  apiKeyEnc String   @default("") @db.Text
  /// 可选的接口地址覆盖；为空时用内置默认
  baseUrl   String   @default("")
  /// 该平台在此用途下选定的模型
  model     String   @default("")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, scope, provider])
}

/// 每日写作流水（date 为东八区 YYYY-MM-DD）
model WritingActivity {
  userId     String
  date       String
  saves      Int    @default(0)
  charsAdded Int    @default(0)
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}

/// MCP 内置的 OAuth 2.1 授权服务器：动态注册（RFC 7591）的客户端。
/// MCP 客户端（Claude Desktop / Cursor）是公有客户端，走 PKCE，无 client_secret。
model OAuthClient {
  id              String              @id @default(cuid()) // client_id
  name            String              @default("") // client_name
  /// 允许的回调地址（JSON 字符串数组）；换码时精确匹配，防开放重定向
  redirectUris    String              @db.Text
  /// 机密客户端的 secret 散列（scrypt）；公有客户端为空
  secretHash      String?
  tokenAuthMethod String              @default("none")
  createdAt       DateTime            @default(now())
  authCodes       OAuthAuthCode[]
  refreshTokens   OAuthRefreshToken[]
}

/// 一次性授权码：只存 sha256，绑定 PKCE challenge、客户端、回调地址与 resource，短 TTL（分钟级）。
model OAuthAuthCode {
  id            String      @id @default(cuid())
  /// sha256(授权码明文)，明文只在回跳 URL 里出现一次
  codeHash      String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String      @db.Text
  codeChallenge String
  codeMethod    String      @default("S256")
  scope         String      @default("")
  /// RFC 8707 目标资源（MCP 服务器规范 URI），换 token 时原样绑定进 aud
  resource      String      @default("")
  expiresAt     DateTime
  /// 已兑换时间；非空表示此码已用过，禁止重放
  consumedAt    DateTime?
  createdAt     DateTime    @default(now())

  @@index([clientId])
}

/// 刷新令牌：只存 sha256，轮换时把旧令牌置 revokedAt。
model OAuthRefreshToken {
  id         String      @id @default(cuid())
  tokenHash  String      @unique
  clientId   String
  client     OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope      String      @default("")
  resource   String      @default("")
  expiresAt  DateTime
  /// 轮换或撤销时间；非空表示不可再用
  revokedAt  DateTime?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([clientId])
}

/// 图片资产（上传/AI 生成到 OSS 的文件索引）
model Asset {
  id        String   @id @default(cuid())
  userId    String
  key       String
  url       String
  size      Int      @default(0)
  mime      String   @default("")
  source    String   @default("upload")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, createdAt(sort: Desc)])
}
