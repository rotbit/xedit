generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String?           @unique
  emailVerified DateTime?
  image         String?
  /// scrypt password hash for email-registered users; null for OAuth users
  passwordHash  String?
  /// Signup time (backfilled by migration for legacy users as the creation time of their earliest document)
  createdAt     DateTime          @default(now())
  /// Last login (written by the next-auth signIn event); null for legacy users until their next login
  lastLoginAt   DateTime?
  /// Read-only ban time; non-null means the user can only view/export, not write or upload
  bannedAt      DateTime?
  /// Ban reason, shown to the banned user with the 403 message
  banReason     String?
  /// Storage quota (bytes); null = use the global default, 0 = unlimited
  storageQuota  BigInt?
  /// Granted feature permission keys (see lib/permissionKeys); new users have none by default; admins ignore this column and get everything
  permissions   String[]          @default([])
  /// Per-account daily AI review limit; null = use the global default (AI_DAILY_LIMIT)
  aiReviewDailyLimit Int?
  /// Per-account daily AI cover generation limit; null = use the global default (COVER_GENERATE_DAILY_LIMIT)
  aiCoverDailyLimit  Int?
  accounts      Account[]
  sessions      Session[]
  documents     Document[]
  settings      UserSettings?
  activities    WritingActivity[]
  assets        Asset[]
  aiProviders   AiProvider[]
  oauthAuthCodes     OAuthAuthCode[]
  oauthRefreshTokens OAuthRefreshToken[]
  dailyActives  DailyActive[]
  feishuConnection FeishuConnection?
  feishuDocLinks   FeishuDocLink[]
  reviewRecords    ReviewRecord[]
  dayLogEvents     DayLogEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Document {
  id        String            @id @default(cuid())
  title     String            @default("未命名文章")
  content   String            @default("") @db.Text
  category  String            @default("未分类")
  /// Soft-delete time; non-null means in the trash
  deletedAt DateTime?
  /// Client-side creation dedupe key: offline creation and flaky-network retries resend the same 「新建」 (create); the same key creates only one doc.
  /// Nullable: old clients and server-side creation (MCP, Feishu sync) don't send it, and Postgres unique indexes default to NULLS DISTINCT,
  /// so multiple NULL rows don't conflict.
  clientKey String?
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions  DocumentVersion[]
  feishuLinks FeishuDocLink[]
  share     DocShare?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, clientKey])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, category])
}

/// Article share link: id is the token in the URL (random hex, not enumerable).
/// At most one per article; closing a share sets enabled=false instead of deleting the row, so the link and annotations survive a reopen.
model DocShare {
  id           String         @id
  documentId   String         @unique
  document     Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId       String
  enabled      Boolean        @default(true)
  /// Whether guests may annotate; when off, the share page hides the annotation column and the body column is wider
  allowComment Boolean        @default(true)
  /// Expiry time; null means permanent (now the default; links are only closed manually by the author).
  /// Kept for possible time-limited shares in the future; logically both null and a future time count as valid
  expiresAt    DateTime?
  createdAt    DateTime       @default(now())
  comments     ShareComment[]
}

/// Share page annotations: anchored to the rendered body's plain text (selected text + preceding text + occurrence number).
/// Guests have no account and claim their annotations via the sha256 of a random browser-local key; the doc author uses the session.
model ShareComment {
  id            String    @id @default(cuid())
  shareId       String
  share         DocShare  @relation(fields: [shareId], references: [id], onDelete: Cascade)
  /// Null for top-level annotations; replies hang under a top-level annotation
  parentId      String?
  author        String
  authorKeyHash String    @default("")
  /// Posted by the logged-in doc author themselves
  isOwner       Boolean   @default(false)
  /// Anchor type: text = selected text (anchorText/Prefix/Index locate a plain-text range);
  /// media = image or video (anchorText stores the src, anchorIndex is which occurrence of that src)
  anchorType    String    @default("text")
  anchorText    String    @default("") @db.Text
  anchorPrefix  String    @default("")
  anchorIndex   Int       @default(0)
  body          String    @db.Text
  /// Resolved time; only meaningful for top-level annotations
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([shareId, createdAt])
  /// Deleting a top-level annotation cascades to replies by parentId; this where doesn't include shareId
  @@index([parentId])
}

// Version snapshots: autosaves are kept at intervals, with one-click rollback
model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title      String
  content    String   @db.Text
  /// auto = automatic snapshot, manual = manual save, restore = automatic backup before a rollback
  kind       String   @default("auto")
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt(sort: Desc)])
}

model UserSettings {
  userId       String  @id
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  themeId      String  @default("classic")
  codeThemeId  String  @default("github")
  customCss    String  @default("") @db.Text
  macCode      Boolean @default(true)
  linkFootnote Boolean @default(true)
  /// User-created categories (JSON array), shown as the union with article categories so empty categories don't disappear
  categories   String  @default("[]")
  /// Manual sidebar order (JSON: { cats: { parentPath: [childName…] }, docs: { category: [docId…] } })
  sidebarOrder String  @default("{}") @db.Text
  /// 「我的主题」 (My themes) saved by the visual theme editor (CustomThemeSpec JSON array)
  customThemes String  @default("[]") @db.Text
  /// Default text platform id (matches AiProvider.provider with scope=chat); null falls back to the first platform with a key filled in
  aiChatProvider  String @default("")
}

/// User-configured AI text platform credentials (for content review). apiKeyEnc is the AES-256-GCM encrypted key; plaintext never touches the DB.
model AiProvider {
  userId    String
  /// Purpose: only chat (text conversation) remains
  scope     String   @default("chat")
  /// Platform id: replicate | moonshot | zhipu | deepseek
  provider  String
  /// Encrypted API key (empty string means not entered yet)
  apiKeyEnc String   @default("") @db.Text
  /// Optional API endpoint override; built-in default when null
  baseUrl   String   @default("")
  /// The model selected for this platform and purpose
  model     String   @default("")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, scope, provider])
}

/// Site-wide key-value settings, writable only from the admin. Two kinds of keys exist:
/// ai.review → JSON {provider, model} (which model site-wide AI review uses);
/// ai.key.<slot> → AES-256-GCM encrypted upstream token (the slot is the envKey in providers.ts).
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/// AI review history: one row per successful run, so it can still be revisited after closing review or switching devices.
/// docId is just a string (no foreign key): even if the article is trashed or deleted, the suggestions from then are kept.
/// Only review results and the 「忽略 / 知道了」 (Ignore / Got it) button actions are stored here; no tokens, no body text.
model ReviewRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docId     String
  /// Which kinds were reviewed, comma-separated (ids from lib/ai/reviewKinds)
  kinds     String
  /// The model used at the time, like deepseek/deepseek-chat, just for context when looking back
  model     String   @default("")
  /// ReviewResult：summary / categories / items
  result    Json
  /// Suggestion id → ignored / acked
  actions   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId, docId, createdAt(sort: Desc)])
}

/// Daily activity tracking (date is YYYY-MM-DD in UTC+8): data source for the admin DAU curve,
/// tracked by key web and MCP endpoints, history backfilled from WritingActivity
model DailyActive {
  userId String
  date   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@index([date])
}

/// Daily writing log (date is YYYY-MM-DD in UTC+8)
model WritingActivity {
  userId     String
  date       String
  saves      Int    @default(0)
  charsAdded Int    @default(0)
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}

/// Daily log for the 「今天」 (Today) page: client-generated ids sync idempotently; day is YYYY-MM-DD in the client's local time zone; deletes use a deletedAt tombstone so other devices know
model DayLogEvent {
  id        String
  userId    String
  day       String
  ts        DateTime
  end       DateTime?
  kind      String
  docId     String?
  title     String?
  chars     Int?
  text      String?
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId, updatedAt])
  @@index([userId, day])
}

/// MCP's built-in OAuth 2.1 authorization server: dynamically registered (RFC 7591) clients.
/// MCP clients (Claude Desktop / Cursor) are public clients using PKCE, with no client_secret.
model OAuthClient {
  id              String              @id @default(cuid()) // client_id
  name            String              @default("") // client_name
  /// Allowed redirect URIs (JSON string array); matched exactly at code exchange to prevent open redirects
  redirectUris    String              @db.Text
  /// Secret hash (scrypt) for confidential clients; null for public clients
  secretHash      String?
  tokenAuthMethod String              @default("none")
  createdAt       DateTime            @default(now())
  authCodes       OAuthAuthCode[]
  refreshTokens   OAuthRefreshToken[]
}

/// One-time authorization code: only the sha256 is stored, bound to the PKCE challenge, client, redirect URI and resource, with a short TTL (minutes).
model OAuthAuthCode {
  id            String      @id @default(cuid())
  /// sha256(plaintext code); the plaintext appears only once, in the redirect URL
  codeHash      String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String      @db.Text
  codeChallenge String
  codeMethod    String      @default("S256")
  scope         String      @default("")
  /// RFC 8707 target resource (MCP server canonical URI), bound into aud as-is at token exchange
  resource      String      @default("")
  expiresAt     DateTime
  /// Redeemed time; non-null means the code has been used, replay is rejected
  consumedAt    DateTime?
  createdAt     DateTime    @default(now())

  @@index([clientId])
}

/// Refresh token: only the sha256 is stored; rotation sets revokedAt on the old token.
model OAuthRefreshToken {
  id         String      @id @default(cuid())
  tokenHash  String      @unique
  clientId   String
  client     OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope      String      @default("")
  resource   String      @default("")
  expiresAt  DateTime
  /// Rotation or revocation time; non-null means no longer usable
  revokedAt  DateTime?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([clientId])
}

/// Feishu connection (for wiki import): app credentials are configured per account, tokens obtained via user-identity OAuth.
/// App Secret and tokens are both stored AES-256-GCM encrypted; plaintext never touches the DB.
model FeishuConnection {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// App ID of the user's own custom Feishu app (not sensitive; used for display and starting authorization)
  appId           String   @default("")
  /// Encrypted App Secret (empty string means not entered yet)
  appSecretEnc    String   @default("") @db.Text
  /// Feishu-side user identifier and display name, for UI display only
  feishuOpenId    String   @default("")
  feishuName      String   @default("")
  accessTokenEnc  String   @default("") @db.Text
  refreshTokenEnc String   @default("") @db.Text
  /// access_token expiry time, refreshed ahead of time
  expiresAt       DateTime @default(now())
  /// Wiki space chosen at the last sync (for display and as the default)
  spaceId         String   @default("")
  spaceName       String   @default("")
  /// OAuth scopes actually granted (empty string = legacy read-only authorization); checked before push to see if write scope is granted
  scopes          String   @default("")
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Sync mapping between Feishu wiki nodes and xedit documents: the basis for incremental skipping and idempotent updates.
/// Attached to User rather than FeishuConnection, so disconnecting and reconnecting Feishu keeps the mappings and doesn't create duplicate docs.
model FeishuDocLink {
  userId      String
  /// wiki node token
  nodeToken   String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Feishu-side edit timestamp (seconds) at the last sync; if unchanged, the whole doc is skipped
  objEditTime String   @default("")
  /// Link source: pull = imported from Feishu, push = pushed from xedit; pulls don't change the category for push-sourced links
  origin      String   @default("pull")
  syncedAt    DateTime @updatedAt

  @@id([userId, nodeToken])
  @@index([userId, documentId])
}

/// Image assets (index of files uploaded/AI-generated to OSS)
model Asset {
  id        String   @id @default(cuid())
  userId    String
  key       String
  url       String
  size      Int      @default(0)
  mime      String   @default("")
  source    String   @default("upload")
  /// Image pixel width; read by the browser on upload, null for server-side paths like MCP/Feishu, backfilled on first frontend display
  width     Int?
  /// Image pixel height; same as width, null for videos and images whose size can't be read
  height    Int?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, createdAt(sort: Desc)])
  /// Feishu sync looks up already-copied assets by source: without this it would have to scan all of the user's assets by userId
  @@index([userId, source])
}
