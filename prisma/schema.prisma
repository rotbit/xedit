generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String?           @unique
  emailVerified DateTime?
  image         String?
  /// 邮箱注册用户的 scrypt 密码散列；OAuth 用户为空
  passwordHash  String?
  /// 注册时间（历史用户由迁移回填为其最早一篇文档的创建时间）
  createdAt     DateTime          @default(now())
  /// 只读封禁时间；非空表示仅可查看导出，不能写入上传
  bannedAt      DateTime?
  /// 封禁原因，随 403 提示展示给被封用户
  banReason     String?
  /// 存储配额（字节）；空 = 用全局默认，0 = 不限制
  storageQuota  BigInt?
  accounts      Account[]
  sessions      Session[]
  documents     Document[]
  settings      UserSettings?
  activities    WritingActivity[]
  assets        Asset[]
  aiProviders   AiProvider[]
  oauthAuthCodes     OAuthAuthCode[]
  oauthRefreshTokens OAuthRefreshToken[]
  dailyActives  DailyActive[]
  feishuConnection FeishuConnection?
  feishuDocLinks   FeishuDocLink[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Document {
  id        String            @id @default(cuid())
  title     String            @default("未命名文章")
  content   String            @default("") @db.Text
  category  String            @default("未分类")
  /// 软删除时间；非空表示在回收站
  deletedAt DateTime?
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions  DocumentVersion[]
  feishuLinks FeishuDocLink[]
  share     DocShare?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, category])
}

/// 文章分享链接：id 即 URL 中的 token（随机 hex，不可枚举）。
/// 一篇文章至多一条；关闭分享置 enabled=false 而不删行，重开时链接与批注都还在。
model DocShare {
  id           String         @id
  documentId   String         @unique
  document     Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId       String
  enabled      Boolean        @default(true)
  /// 是否允许访客批注
  allowComment Boolean        @default(true)
  /// 到期时刻（开启/重开时顺延 48 小时），过期后访问与批注都拒绝
  expiresAt    DateTime
  createdAt    DateTime       @default(now())
  comments     ShareComment[]
}

/// 分享页批注：锚定在渲染后正文的纯文本上（选中文本 + 前文 + 第几次出现）。
/// 访客无账号，凭浏览器本地随机 key 的 sha256 认领自己的批注；文档作者走登录态。
model ShareComment {
  id            String    @id @default(cuid())
  shareId       String
  share         DocShare  @relation(fields: [shareId], references: [id], onDelete: Cascade)
  /// 顶级批注为空；回复挂在顶级批注下
  parentId      String?
  author        String
  authorKeyHash String    @default("")
  /// 登录态的文档作者本人发表
  isOwner       Boolean   @default(false)
  anchorText    String    @default("") @db.Text
  anchorPrefix  String    @default("")
  anchorIndex   Int       @default(0)
  body          String    @db.Text
  /// 解决（销记）时间；仅顶级批注有意义
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([shareId, createdAt])
}

// 版本快照：自动保存按时间间隔留存，支持一键回滚
model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title      String
  content    String   @db.Text
  /// auto = 自动留存, manual = 手动存档, restore = 回滚前的自动备份
  kind       String   @default("auto")
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt(sort: Desc)])
}

model UserSettings {
  userId       String  @id
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  themeId      String  @default("classic")
  codeThemeId  String  @default("github")
  customCss    String  @default("") @db.Text
  macCode      Boolean @default(true)
  linkFootnote Boolean @default(true)
  /// 用户自建分类（JSON 数组），与文章上的分类取并集展示，保证空分类不消失
  categories   String  @default("[]")
  /// 可视化主题编辑器保存的「我的主题」（CustomThemeSpec JSON 数组）
  customThemes String  @default("[]") @db.Text
  /// 默认文本平台 id（对应 scope=chat 的 AiProvider.provider）；为空表示回落到首个已填密钥的平台
  aiChatProvider  String @default("")
}

/// 用户配置的 AI 文本平台凭据（内容审查用）。apiKeyEnc 为 AES-256-GCM 加密后的密钥，明文绝不落库。
model AiProvider {
  userId    String
  /// 用途：现仅剩 chat（文本对话）
  scope     String   @default("chat")
  /// 平台 id：replicate | moonshot | zhipu | deepseek
  provider  String
  /// 加密后的 API Key（空串表示尚未填写）
  apiKeyEnc String   @default("") @db.Text
  /// 可选的接口地址覆盖；为空时用内置默认
  baseUrl   String   @default("")
  /// 该平台在此用途下选定的模型
  model     String   @default("")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, scope, provider])
}

/// 每日活跃打点（date 为东八区 YYYY-MM-DD）：后台 DAU 曲线的数据源，
/// 网页与 MCP 的关键接口都会打点，历史由 WritingActivity 回填
model DailyActive {
  userId String
  date   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@index([date])
}

/// 每日写作流水（date 为东八区 YYYY-MM-DD）
model WritingActivity {
  userId     String
  date       String
  saves      Int    @default(0)
  charsAdded Int    @default(0)
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}

/// MCP 内置的 OAuth 2.1 授权服务器：动态注册（RFC 7591）的客户端。
/// MCP 客户端（Claude Desktop / Cursor）是公有客户端，走 PKCE，无 client_secret。
model OAuthClient {
  id              String              @id @default(cuid()) // client_id
  name            String              @default("") // client_name
  /// 允许的回调地址（JSON 字符串数组）；换码时精确匹配，防开放重定向
  redirectUris    String              @db.Text
  /// 机密客户端的 secret 散列（scrypt）；公有客户端为空
  secretHash      String?
  tokenAuthMethod String              @default("none")
  createdAt       DateTime            @default(now())
  authCodes       OAuthAuthCode[]
  refreshTokens   OAuthRefreshToken[]
}

/// 一次性授权码：只存 sha256，绑定 PKCE challenge、客户端、回调地址与 resource，短 TTL（分钟级）。
model OAuthAuthCode {
  id            String      @id @default(cuid())
  /// sha256(授权码明文)，明文只在回跳 URL 里出现一次
  codeHash      String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String      @db.Text
  codeChallenge String
  codeMethod    String      @default("S256")
  scope         String      @default("")
  /// RFC 8707 目标资源（MCP 服务器规范 URI），换 token 时原样绑定进 aud
  resource      String      @default("")
  expiresAt     DateTime
  /// 已兑换时间；非空表示此码已用过，禁止重放
  consumedAt    DateTime?
  createdAt     DateTime    @default(now())

  @@index([clientId])
}

/// 刷新令牌：只存 sha256，轮换时把旧令牌置 revokedAt。
model OAuthRefreshToken {
  id         String      @id @default(cuid())
  tokenHash  String      @unique
  clientId   String
  client     OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope      String      @default("")
  resource   String      @default("")
  expiresAt  DateTime
  /// 轮换或撤销时间；非空表示不可再用
  revokedAt  DateTime?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([clientId])
}

/// 飞书连接（知识库导入用）：应用凭证按账号各自配置，token 走用户身份 OAuth 获取。
/// App Secret 与 token 均 AES-256-GCM 加密存储，明文绝不落库。
model FeishuConnection {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 用户自己创建的飞书自建应用 App ID（非敏感，用于回显与发起授权）
  appId           String   @default("")
  /// 加密后的 App Secret（空串表示尚未填写）
  appSecretEnc    String   @default("") @db.Text
  /// 飞书侧用户标识与展示名，仅用于界面回显
  feishuOpenId    String   @default("")
  feishuName      String   @default("")
  accessTokenEnc  String   @default("") @db.Text
  refreshTokenEnc String   @default("") @db.Text
  /// access_token 过期时刻，提前刷新
  expiresAt       DateTime @default(now())
  /// 上次同步选择的知识空间（回显与默认值）
  spaceId         String   @default("")
  spaceName       String   @default("")
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// 飞书 wiki 节点 ↔ xedit 文档的同步映射：增量跳过与幂等更新的依据。
/// 挂在 User 而非 FeishuConnection 下：断开重连飞书不丢映射，不会重复建档。
model FeishuDocLink {
  userId      String
  /// wiki 节点 token
  nodeToken   String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// 上次同步时飞书侧的编辑时间戳（秒），未变则整篇跳过
  objEditTime String   @default("")
  syncedAt    DateTime @updatedAt

  @@id([userId, nodeToken])
  @@index([userId, documentId])
}

/// 图片资产（上传/AI 生成到 OSS 的文件索引）
model Asset {
  id        String   @id @default(cuid())
  userId    String
  key       String
  url       String
  size      Int      @default(0)
  mime      String   @default("")
  source    String   @default("upload")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, createdAt(sort: Desc)])
}
