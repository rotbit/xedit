# 复制成 .env 后填写。.env 已被 .gitignore 忽略，切勿把真实密钥提交进仓库。
# cp .env.example .env

# ---- 必填 ----

# PostgreSQL 连接串。
# 用 docker compose 部署时不必填 DATABASE_URL，改填下面的 POSTGRES_PASSWORD 即可。
DATABASE_URL="postgresql://用户名:密码@localhost:5432/xedit"

# 会话与 MCP 令牌的签名密钥，用 `openssl rand -base64 32` 生成
AUTH_SECRET=""

# ---- 仅 docker compose 部署需要 ----

# compose 会用它建库并拼出容器内的 DATABASE_URL
POSTGRES_PASSWORD=""
# 宿主机映射端口，默认 3000
PORT=""

# ---- 可选：站点 ----

# 公网地址。落地页的 canonical、Open Graph 图、robots.txt 与 sitemap.xml 都以它为准；
# 留空默认 https://xedit.me。自建部署换成自己的域名，不要带结尾斜杠。
NEXT_PUBLIC_SITE_URL=""

# 反向代理后建议显式指定，供 Auth.js 拼回调地址，如 https://example.com
AUTH_URL=""

# ---- 可选：登录方式 ----
# 邮箱 + 密码注册登录始终可用；以下两个第三方登录填了才会出现在登录框里。

# GitHub OAuth（https://github.com/settings/developers 创建 OAuth App）
# 回调地址填 http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth（https://console.cloud.google.com 创建 OAuth 客户端）
# 回调地址填 http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- 可选：图床（阿里云 OSS）----
# 不填则编辑器里粘贴图片不会上传，其余功能不受影响。

OSS_REGION=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET=""
# 绑定的 CDN/自定义域名，如 https://img.example.com
OSS_CDN_DOMAIN=""

# ---- 可选：AI ----

# 用户在「AI 设置」里填的平台 Key 会用它 AES-256-GCM 加密后入库。
# 留空则自动从 AUTH_SECRET 派生；一旦启用请勿再更改，否则已存的 Key 无法解密、需重填。
AI_ENCRYPTION_KEY=""
