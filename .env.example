# Copy to .env and fill in. .env is ignored by .gitignore; never commit real secrets to the repo.
# cp .env.example .env

# ---- Required ----

# PostgreSQL connection string.
# When deploying with docker compose, skip DATABASE_URL and set POSTGRES_PASSWORD below instead.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/xedit"

# Signing secret for sessions and MCP tokens; generate with `openssl rand -base64 32`
AUTH_SECRET=""

# ---- Only needed for docker compose deployments ----

# compose uses it to create the database and build the in-container DATABASE_URL
POSTGRES_PASSWORD=""
# Host port mapping, default 3000
PORT=""

# ---- Optional: site ----

# Public URL. The landing page's canonical, Open Graph images, robots.txt and sitemap.xml all use it;
# defaults to https://xedit.me if empty. Self-hosters set their own domain, without a trailing slash.
NEXT_PUBLIC_SITE_URL=""

# Recommended to set explicitly behind a reverse proxy so Auth.js can build callback URLs, e.g. https://example.com
AUTH_URL=""

# ---- Optional: sign-in methods ----
# Email + password signup/login is always available; the third-party logins below appear in the login box only when configured.

# GitHub OAuth (create an OAuth App at https://github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth (create an OAuth client at https://console.cloud.google.com)
# Callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Explicit switch for WeChat login; set to 1 or true to enable.
# WeChat login needs a business-verified Open Platform account (individual developers can't apply), a higher bar than the two above;
# leave empty to disable; the WeChat login button won't appear even if the ID/Secret below are filled in.
AUTH_WECHAT_ENABLED=""

# AppID / AppSecret of a 「网站应用」 (Website app) on the WeChat Open Platform (https://open.weixin.qq.com).
# Set the authorized callback domain to your site's domain (domain only, no protocol or path); the actual callback URL is
# http://localhost:3000/api/auth/callback/wechat
AUTH_WECHAT_ID=""
AUTH_WECHAT_SECRET=""

# website (default) = Open Platform website app, PC QR-code login;
# official = WeChat Official Account web authorization, only works in WeChat's in-app browser.
AUTH_WECHAT_PLATFORM=""

# ---- Optional: image hosting (Alibaba Cloud OSS) ----
# If unset, images pasted in the editor aren't uploaded; everything else works.

OSS_REGION=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET=""
# Bound CDN/custom domain, e.g. https://img.example.com
OSS_CDN_DOMAIN=""

# ---- Optional: AI ----

# Platform keys users enter in 「AI 设置」 (AI settings) are AES-256-GCM encrypted with this before being stored.
# If empty, it's derived from AUTH_SECRET; once in use don't change it, or stored keys can't be decrypted and must be re-entered.
AI_ENCRYPTION_KEY=""

# ---- Optional: AI cover generation (Replicate) ----
# When set, an 「AI 生成」 (AI generate) tab appears in 「设置封面」 (Set cover). Generation is billed per image to the site's own
# Replicate account, so it's only open to accounts on the ADMIN_EMAILS allowlist, with a per-account limit
# (one at a time, COVER_GENERATE_DAILY_LIMIT per day). If empty, the feature is off and nothing else is affected.

# Get one at https://replicate.com/account/api-tokens (starts with r8_); stays server-side, never sent to the browser
REPLICATE_API_TOKEN=""
# Image model; defaults to black-forest-labs/flux-schnell if empty (a few seconds per image, the cheapest tier).
# To pin a version, write owner/name:version. Switching models needs no manual input checks: aspect ratios and optional fields the model rejects
# (num_outputs / output_format / output_quality) are adjusted automatically from the upstream error and retried
REPLICATE_MODEL=""
# Cover aspect ratio; empty = auto: try 21:9 first, and if unsupported use the widest landscape ratio the model supports
REPLICATE_ASPECT_RATIO=""
# Timeout per generation (seconds); defaults to 90 if empty
COVER_GENERATE_TIMEOUT_SEC=""
# Max generations per account per calendar day; defaults to 20 if empty
COVER_GENERATE_DAILY_LIMIT=""

# ---- Optional: AI article review ----
# Which provider's model and each provider's token are configured in 「AI 设置」 (AI settings) in the admin (/admin);
# tokens are encrypted with AI_ENCRYPTION_KEY above (or AUTH_SECRET if unset) before being stored;
# if you change that key, tokens entered in the admin must be re-entered.
# The env vars below are only a fallback: read only for providers not filled in the admin. Defaults to DeepSeek.
# Only open to accounts on the ADMIN_EMAILS allowlist, AI_DAILY_LIMIT times per account per day.
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# MOONSHOT_API_KEY=
# ZHIPU_API_KEY=
# (Claude / GPT on Replicate use the REPLICATE_API_TOKEN above)
# AI_DAILY_LIMIT=

# ---- Optional: admin ----

# Super-admin email allowlist (comma-separated, case-insensitive). After logging in, listed accounts
# see 「管理后台」 (Admin) (/admin) in the account menu: account list, read-only bans, storage quota adjustment, account deletion.
# If empty, the admin is closed to everyone.
ADMIN_EMAILS=""

# Per-account asset storage quota (MB); new uploads are blocked once exceeded. Defaults to 10240 (10GB) if empty;
# adjustable per account in the admin (including unlimited).
DEFAULT_STORAGE_QUOTA_MB=""
